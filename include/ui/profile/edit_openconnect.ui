      <item row="6" column="0">
       <widget class="QLabel" name="otp_profile_l">
        <property name="text">
         <string>OTP</string>
        </property>
        <property name="buddy">
         <cstring>otp_profile</cstring>
        </property>
       </widget>
      </item>
      <item row="6" column="1">
       <widget class="QComboBox" name="otp_profile"/>
      </item>
      <item row="7" column="0" colspan="2">
       <widget class="QCheckBox" name="only_advertised_routes">
        <property name="toolTip">
         <string>Block traffic outside the subnets the VPN server advertises.</string>
        </property>
        <property name="text">
         <string>Only route advertised network</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
       </widget>
      </item>
      <item row="8" column="0">
       <widget class="QLabel" name="tunnel_dns_l">
        <property name="toolTip">
