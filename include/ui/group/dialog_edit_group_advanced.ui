<ui version="4.0">
 <class>DialogEditGroupAdvanced</class>
 <widget class="QDialog" name="DialogEditGroupAdvanced">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>460</width>
    <height>621</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Advanced Subscription Settings</string>
  </property>
  <layout class="QVBoxLayout" name="verticalLayout">
   <item>
    <widget class="QGroupBox" name="request_box">
     <property name="title">
      <string>Request</string>
     </property>
     <layout class="QGridLayout" name="request_layout">
      <item row="0" column="0">
       <widget class="QLabel" name="user_agent_l">
        <property name="toolTip">
         <string>Empty uses the User Agent from the Subscription settings.</string>
        </property>
        <property name="text">
         <string>User Agent</string>
        </property>
       </widget>
      </item>
      <item row="0" column="1">
       <widget class="MyLineEdit" name="user_agent"/>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="tls_version_l">
        <property name="toolTip">
         <string>TLS versions offered when fetching this subscription. Some servers answer the default handshake with a CAPTCHA or a block page; TLS 1.2 often gets through. Keep Default follows the Subscription settings.</string>
        </property>
        <property name="text">
         <string>TLS Version</string>
        </property>
       </widget>
      </item>
      <item row="1" column="1">
       <widget class="QComboBox" name="tls_version">
        <item>
         <property name="text">
          <string>Keep Default</string>
         </property>
        </item>
        <item>
         <property name="text">
          <string>Auto</string>
         </property>
        </item>
        <item>
         <property name="text">
          <string>TLS 1.2</string>
         </property>
        </item>
        <item>
         <property name="text">
          <string>TLS 1.3</string>
         </property>
        </item>
       </widget>
      </item>
      <item row="2" column="0">
       <widget class="QLabel" name="http_version_l">
        <property name="toolTip">
         <string>Auto uses HTTP/2 when the server offers it. Keep Default follows the Subscription settings.</string>
        </property>
        <property name="text">
         <string>HTTP Version</string>
        </property>
       </widget>
      </item>
      <item row="2" column="1">
       <widget class="QComboBox" name="http_version">
        <item>
         <property name="text">
          <string>Keep Default</string>
         </property>
        </item>
        <item>
         <property name="text">
          <string>Auto</string>
         </property>
        </item>
        <item>
         <property name="text">
          <string>HTTP/1.1</string>
         </property>
        </item>
       </widget>
      </item>
      <item row="3" column="0">
       <widget class="QLabel" name="send_hwid_l">
        <property name="toolTip">
         <string>Send the HWID, OS, OS version and device model headers with this subscription's requests. Keep Default follows the Subscription settings.</string>
        </property>
        <property name="text">
         <string>Send HWID</string>
        </property>
       </widget>
      </item>
      <item row="3" column="1">
       <widget class="QComboBox" name="send_hwid">
        <item>
         <property name="text">
          <string>Keep Default</string>
         </property>
        </item>
        <item>
         <property name="text">
          <string>On</string>
         </property>
        </item>
        <item>
         <property name="text">
          <string>Off</string>
         </property>
        </item>
       </widget>
      </item>
      <item row="4" column="0">
       <widget class="QLabel" name="hwid_l">
        <property name="text">
         <string>HWID</string>
        </property>
       </widget>
      </item>
      <item row="4" column="1">
       <widget class="MyLineEdit" name="hwid"/>
      </item>
      <item row="5" column="0">
       <widget class="QLabel" name="hwid_os_l">
        <property name="text">
         <string>OS</string>
        </property>
       </widget>
      </item>
      <item row="5" column="1">
       <widget class="MyLineEdit" name="hwid_os"/>
      </item>
      <item row="6" column="0">
       <widget class="QLabel" name="hwid_os_version_l">
        <property name="text">
         <string>OS Version</string>
        </property>
       </widget>
      </item>
      <item row="6" column="1">
       <widget class="MyLineEdit" name="hwid_os_version"/>
      </item>
      <item row="7" column="0">
       <widget class="QLabel" name="hwid_model_l">
        <property name="text">
         <string>Device Model</string>
        </property>
       </widget>
      </item>
      <item row="7" column="1">
       <widget class="MyLineEdit" name="hwid_model"/>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="update_box">
     <property name="title">
      <string>Update</string>
     </property>
     <layout class="QVBoxLayout" name="update_layout">
      <item>
       <widget class="QCheckBox" name="keep_working">
        <property name="toolTip">
         <string>Profiles whose last test succeeded are kept when the subscription no longer lists them.</string>
        </property>
        <property name="text">
         <string>Keep working profiles</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QLabel" name="after_update_l">
        <property name="text">
         <string>After each update:</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QCheckBox" name="remove_duplicates">
        <property name="text">
         <string>Remove duplicate profiles</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QCheckBox" name="remove_insecure">
        <property name="text">
         <string>Remove insecure profiles</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QCheckBox" name="remove_invalid">
        <property name="toolTip">
         <string>Profiles the core rejects. Skipped while the core is unreachable.</string>
        </property>
        <property name="text">
         <string>Remove invalid profiles</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QCheckBox" name="url_test">
        <property name="toolTip">
         <string>Tests the group's profiles once the update finishes, after any test already running.</string>
        </property>
        <property name="text">
         <string>Run URL test</string>
        </property>
       </widget>
      </item>
      <item>
       <layout class="QVBoxLayout" name="url_test_follow_ups">
        <item>
         <widget class="QCheckBox" name="remove_unavailable">
          <property name="text">
           <string>Remove unavailable profiles</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QCheckBox" name="sort_by_latency">
          <property name="text">
           <string>Sort by latency</string>
          </property>
         </widget>
        </item>
       </layout>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <spacer name="bottom_spacer">
     <property name="orientation">
