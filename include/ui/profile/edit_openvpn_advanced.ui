              <widget class="NoWheelComboBox" name="key_direction"/>
             </item>
             <item row="3" column="0">
              <widget class="QLabel" name="cipher_l">
               <property name="toolTip">
                <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Data channel cipher used in static_key mode. The upstream default BF-CBC is used when empty.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
               </property>
               <property name="text">
                <string>Data Cipher</string>
               </property>
               <property name="buddy">
                <cstring>cipher</cstring>
