             </item>
             <item row="0" column="1">
              <widget class="QLineEdit" name="mobile_platform_version"/>
             </item>
             <item row="1" column="0">
              <widget class="QLabel" name="mobile_device_type_l">
               <property name="toolTip">
                <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Mobile device model or type reported to the AnyConnect server.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
               </property>
               <property name="text">
                <string>Device Type</string>
               </property>
               <property name="buddy">
