# Environment for throne.service (EnvironmentFile=-/etc/throne/throne.env).
# Everything is commented out: the defaults need no entry. Uncomment a line to override it, then run
#   sudo systemctl restart throne
# A command-line flag wins over its variable; Throne --headless --help lists both. The data directory is
# set by the unit (--data-dir), so THRONE_DATA_DIR has no effect here.
# Never put an API key in this file: point THRONE_API_KEY_FILE at a key file instead.

# Throne API listener: PORT, IPv4:PORT, [IPv6]:PORT, *:PORT, or off.
# Default: 127.0.0.1:9095, unless the settings enable the API.
#THRONE_API_LISTEN=127.0.0.1:9095

# API key file; it must exist (create one with: thronectl keygen -o FILE).
# Default: /var/lib/throne/config/api.key, created on the first start.
#THRONE_API_KEY_FILE=/etc/throne/api.key

# 1: accept management requests from the local network, not only from this host.
#THRONE_API_ADMIN_LAN=1

# Addresses or subnets allowed to use a non-local listener, separated by commas.
# Leave it commented out to allow every address; an empty value refuses to start.
#THRONE_API_ALLOW=192.168.1.0/24,fd00::/8

# 0: do not reconnect the last profile at start.
#THRONE_RESUME=0

# 0: keep the kill switch off for this run even when the settings turn it on; profiles stay refused
# until kill_switch is turned off. Meant for recovering access, not for normal runs.
#THRONE_KILL_SWITCH=0

# Log format: auto, journal (systemd priority prefixes) or plain.
#THRONE_LOG_FORMAT=auto

# What a restart request (exit code 75) does: auto (exit under systemd), exit or exec.
#THRONE_RESTART_MODE=auto
