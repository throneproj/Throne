       <item>
        <widget class="QGroupBox" name="tls_spoof_box">
         <property name="title">
          <string>TLS Spoof</string>
         </property>
         <layout class="QHBoxLayout" name="horizontalLayout_tls_spoof">
          <item>
           <widget class="QLabel" name="tls_spoof_l">
            <property name="toolTip">
             <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Inject a forged TLS ClientHello carrying this SNI before the real one, to pass SNI filtering that allows specific hostnames. Profiles that set their own Spoof SNI override this one.&lt;/p&gt;&lt;p&gt;Client only. Requires elevated privileges (root on macOS, CAP_NET_RAW and CAP_NET_ADMIN on Linux, Administrator on Windows for the WinDivert driver). Not supported on Windows ARM64. &amp;quot;wrong-timestamp&amp;quot; is not supported on macOS.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
            </property>
            <property name="text">
             <string>Spoof SNI</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QLineEdit" name="tls_spoof">
            <property name="maximumSize">
             <size>
              <width>160</width>
              <height>16777215</height>
             </size>
            </property>
            <property name="placeholderText">
             <string>Allowed SNI to forge</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QLabel" name="tls_spoof_method_l">
            <property name="text">
             <string>Method</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QComboBox" name="tls_spoof_method">
            <property name="toolTip">
             <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;How the forged ClientHello is made invalid for the server, so only the filter acts on it. Empty keeps the core's default.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QCheckBox" name="tls_spoof_default_on">
            <property name="toolTip">
             <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Spoof profiles whose TLS Spoof setting is left on &amp;quot;Keep Default&amp;quot;.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
            </property>
            <property name="text">
             <string>Default On</string>
            </property>
           </widget>
          </item>
          <item>
