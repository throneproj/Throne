              </widget>
             </item>
             <item row="9" column="1">
              <widget class="QLineEdit" name="tls_mca_key_password"/>
             </item>
            </layout>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="mobile_box">
         <property name="toolTip">
          <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;All three fields are required when a mobile identity is configured.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
         </property>
         <property name="title">
          <string>Mobile Identity</string>
         </property>
         <layout class="QVBoxLayout" name="mobile_box_layout">
          <item>
           <widget class="QWidget" name="mobile_box_form_w" native="true">
            <layout class="QFormLayout" name="mobile_box_form">
             <item row="0" column="0">
              <widget class="QLabel" name="mobile_platform_version_l">
               <property name="toolTip">
                <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Mobile operating system version reported to the AnyConnect server.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
               </property>
               <property name="text">
                <string>Platform Version</string>
               </property>
               <property name="buddy">
                <cstring>mobile_platform_version</cstring>
               </property>
