             </item>
             <item row="1" column="0" colspan="2">
              <widget class="QCheckBox" name="tls_system_trust_disabled">
               <property name="toolTip">
                <string>Trust only your CA certificate or peer fingerprints, not the system's.</string>
               </property>
               <property name="text">
                <string>Disable the system CA certificate pool</string>
