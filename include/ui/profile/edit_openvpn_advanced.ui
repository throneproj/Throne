       <item>
        <widget class="QGroupBox" name="data_box">
         <property name="title">
          <string>Data Channel</string>
         </property>
         <layout class="QVBoxLayout" name="data_box_layout">
          <item>
           <widget class="QWidget" name="data_box_form_w" native="true">
            <layout class="QFormLayout" name="data_box_form">
             <item row="0" column="0">
              <widget class="QLabel" name="data_ciphers_l">
               <property name="toolTip">
                <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Comma separated allowed data channel ciphers. Only available in TLS mode.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
               </property>
               <property name="text">
                <string>Data Ciphers</string>
               </property>
               <property name="buddy">
                <cstring>data_ciphers</cstring>
               </property>
              </widget>
             </item>
             <item row="0" column="1">
              <widget class="QLineEdit" name="data_ciphers">
               <property name="placeholderText">
                <string>AES-256-GCM,AES-128-GCM,CHACHA20-POLY1305</string>
               </property>
              </widget>
             </item>
             <item row="1" column="0">
              <widget class="QLabel" name="data_ciphers_fallback_l">
               <property name="toolTip">
                <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Data channel cipher for peers that do not support cipher negotiation.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
               </property>
               <property name="text">
                <string>Data Ciphers Fallback</string>
               </property>
               <property name="buddy">
                <cstring>data_ciphers_fallback</cstring>
               </property>
              </widget>
             </item>
             <item row="1" column="1">
              <widget class="QLineEdit" name="data_ciphers_fallback"/>
             </item>
             <item row="2" column="0">
              <widget class="QLabel" name="auth_l">
               <property name="toolTip">
                <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Data channel authentication digest. SHA1 is used by default and only applies to non-AEAD ciphers and tls_auth.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
               </property>
               <property name="text">
                <string>Auth Digest</string>
               </property>
               <property name="buddy">
                <cstring>auth</cstring>
               </property>
              </widget>
             </item>
             <item row="2" column="1">
              <widget class="QLineEdit" name="auth"/>
             </item>
             <item row="3" column="0">
              <widget class="QLabel" name="mss_fix_l">
               <property name="toolTip">
                <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Maximum UDP packet size used to clamp the MSS of TCP connections sent through the tunnel.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
               </property>
               <property name="text">
                <string>MSS Fix</string>
               </property>
               <property name="buddy">
                <cstring>mss_fix</cstring>
               </property>
              </widget>
             </item>
             <item row="3" column="1">
              <widget class="QLineEdit" name="mss_fix"/>
             </item>
             <item row="4" column="0" colspan="2">
              <widget class="QCheckBox" name="mss_fix_disabled">
               <property name="toolTip">
                <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Disables MSS clamping including the default clamp. Conflicts with MSS Fix and MSS Fix Mode.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
               </property>
               <property name="text">
                <string>Disable MSS clamping</string>
               </property>
              </widget>
             </item>
             <item row="5" column="0">
              <widget class="QLabel" name="mss_fix_mode_l">
               <property name="toolTip">
                <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;mtu also accounts for the outer IP and transport headers; fixed treats MSS Fix as an inner IPv4 packet size. Requires MSS Fix.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
               </property>
               <property name="text">
                <string>MSS Fix Mode</string>
               </property>
               <property name="buddy">
                <cstring>mss_fix_mode</cstring>
               </property>
              </widget>
             </item>
             <item row="5" column="1">
              <widget class="NoWheelComboBox" name="mss_fix_mode"/>
             </item>
             <item row="6" column="0">
              <widget class="QLabel" name="fragment_l">
               <property name="toolTip">
                <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Maximum UDP packet size used for data channel fragmentation. A non-zero value must be at least 68. Conflicts with TCP transport.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
               </property>
               <property name="text">
                <string>Fragment</string>
               </property>
               <property name="buddy">
                <cstring>fragment</cstring>
               </property>
              </widget>
             </item>
             <item row="6" column="1">
              <widget class="QLineEdit" name="fragment"/>
             </item>
             <item row="7" column="0">
              <widget class="QLabel" name="replay_window_l">
               <property name="toolTip">
                <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;UDP replay window size. 64 is used by default and the maximum is 65536.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
               </property>
               <property name="text">
                <string>Replay Window</string>
               </property>
               <property name="buddy">
                <cstring>replay_window</cstring>
               </property>
              </widget>
             </item>
             <item row="7" column="1">
              <widget class="QLineEdit" name="replay_window"/>
             </item>
             <item row="8" column="0">
              <widget class="QLabel" name="replay_window_time_l">
               <property name="toolTip">
                <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;UDP replay window duration in whole seconds. The maximum is 10m.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
               </property>
               <property name="text">
                <string>Replay Window Time</string>
               </property>
               <property name="buddy">
                <cstring>replay_window_time</cstring>
               </property>
              </widget>
             </item>
             <item row="8" column="1">
              <widget class="QLineEdit" name="replay_window_time">
               <property name="placeholderText">
                <string>15s (default)</string>
               </property>
              </widget>
             </item>
            </layout>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="compression_box">
         <property name="title">
          <string>Compression</string>
         </property>
         <layout class="QVBoxLayout" name="compression_box_layout">
          <item>
           <widget class="QWidget" name="compression_box_form_w" native="true">
            <layout class="QFormLayout" name="compression_box_form">
             <item row="0" column="0">
              <widget class="QLabel" name="compression_l">
               <property name="toolTip">
                <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;OpenVPN compress framing mode. Disabled by default. Compression can weaken traffic confidentiality.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
               </property>
               <property name="text">
                <string>Compression</string>
               </property>
               <property name="buddy">
                <cstring>compression</cstring>
               </property>
              </widget>
             </item>
             <item row="0" column="1">
              <widget class="NoWheelComboBox" name="compression"/>
             </item>
             <item row="1" column="0">
              <widget class="QLabel" name="compression_lzo_l">
               <property name="toolTip">
                <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;OpenVPN comp-lzo mode. Disabled by default. Enable it only when required by the server.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
               </property>
               <property name="text">
                <string>Compression LZO</string>
               </property>
               <property name="buddy">
                <cstring>compression_lzo</cstring>
               </property>
              </widget>
             </item>
             <item row="1" column="1">
              <widget class="NoWheelComboBox" name="compression_lzo"/>
             </item>
             <item row="2" column="0">
              <widget class="QLabel" name="allow_compression_l">
               <property name="toolTip">
                <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Policy for compression pushed by the server. no is used by default and permits only stub framing.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
               </property>
               <property name="text">
                <string>Allow Compression</string>
               </property>
               <property name="buddy">
                <cstring>allow_compression</cstring>
               </property>
              </widget>
             </item>
             <item row="2" column="1">
              <widget class="NoWheelComboBox" name="allow_compression"/>
             </item>
            </layout>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="routing_box">
         <property name="title">
          <string>Routing</string>
         </property>
         <layout class="QVBoxLayout" name="routing_box_layout">
          <item>
           <widget class="QWidget" name="routing_box_form_w" native="true">
            <layout class="QFormLayout" name="routing_box_form">
             <item row="0" column="0" colspan="2">
              <widget class="QCheckBox" name="route_no_pull">
               <property name="toolTip">
                <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Ignores routes, DNS, route metrics, redirect-gateway, redirect-private and block-ipv6 pushed by the server.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
               </property>
               <property name="text">
                <string>Ignore pushed routes, DNS and gateway options</string>
               </property>
              </widget>
             </item>
             <item row="1" column="0">
              <widget class="QLabel" name="routes_l">
               <property name="toolTip">
                <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Comma separated prefixes preferred for this endpoint, in addition to routes accepted from the server.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
               </property>
               <property name="text">
                <string>Routes</string>
               </property>
               <property name="buddy">
                <cstring>routes</cstring>
               </property>
              </widget>
             </item>
             <item row="1" column="1">
              <widget class="QLineEdit" name="routes"/>
             </item>
             <item row="2" column="0">
              <widget class="QLabel" name="route_gateway_l">
               <property name="toolTip">
                <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;IPv4 gateway for routes through the endpoint. The gateway received from the server is used when empty.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
               </property>
               <property name="text">
                <string>Route Gateway</string>
               </property>
               <property name="buddy">
                <cstring>route_gateway</cstring>
               </property>
              </widget>
             </item>
             <item row="2" column="1">
              <widget class="QLineEdit" name="route_gateway"/>
             </item>
             <item row="3" column="0">
              <widget class="QLabel" name="route_metric_l">
               <property name="toolTip">
                <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Default metric for routes through the endpoint. The platform default is used when empty.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
               </property>
               <property name="text">
                <string>Route Metric</string>
               </property>
               <property name="buddy">
                <cstring>route_metric</cstring>
               </property>
              </widget>
             </item>
             <item row="3" column="1">
              <widget class="QLineEdit" name="route_metric"/>
             </item>
             <item row="4" column="0" colspan="2">
              <widget class="QCheckBox" name="redirect_gateway">
               <property name="toolTip">
                <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Does not install an operating system default route.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
               </property>
               <property name="text">
                <string>Prefer this endpoint for all IPv4 destinations</string>
               </property>
              </widget>
             </item>
             <item row="5" column="0">
              <widget class="QLabel" name="redirect_gateway_flags_l">
               <property name="toolTip">
                <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Comma separated OpenVPN redirect-gateway flags, for example !ipv4, def1 or ipv6.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
               </property>
               <property name="text">
                <string>Redirect Gateway Flags</string>
               </property>
               <property name="buddy">
                <cstring>redirect_gateway_flags</cstring>
               </property>
              </widget>
             </item>
             <item row="5" column="1">
              <widget class="QLineEdit" name="redirect_gateway_flags"/>
             </item>
             <item row="6" column="0" colspan="2">
              <widget class="QCheckBox" name="redirect_private">
               <property name="text">
                <string>Accept redirect gateway flags without a default route preference</string>
               </property>
              </widget>
             </item>
             <item row="7" column="0" colspan="2">
              <widget class="QCheckBox" name="block_ipv6">
               <property name="text">
                <string>Reject IPv6 traffic locally instead of sending it through the VPN</string>
               </property>
              </widget>
             </item>
            </layout>
           </widget>
          </item>
          <item>
           <widget class="QTableWidget" name="pull_filters_table">
            <property name="toolTip">
             <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Ordered filters for options pushed by the server. The first filter whose text is a case-sensitive prefix of the complete pushed option is applied.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
            </property>
            <property name="selectionBehavior">
             <enum>QAbstractItemView::SelectRows</enum>
            </property>
            <property name="sizeAdjustPolicy">
             <enum>QAbstractScrollArea::AdjustToContents</enum>
            </property>
            <column>
             <property name="text">
              <string>Action</string>
             </property>
            </column>
            <column>
             <property name="text">
              <string>Text</string>
             </property>
            </column>
           </widget>
          </item>
          <item>
           <layout class="QHBoxLayout" name="pull_filters_table_buttons">
            <item>
             <widget class="QPushButton" name="pull_filters_table_add">
              <property name="text">
               <string>Add</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QPushButton" name="pull_filters_table_remove">
              <property name="text">
               <string>Remove</string>
              </property>
             </widget>
            </item>
            <item>
             <spacer name="pull_filters_table_spacer">
              <property name="orientation">
               <enum>Qt::Horizontal</enum>
              </property>
              <property name="sizeHint">
               <size>
                <width>0</width>
                <height>0</height>
               </size>
              </property>
             </spacer>
            </item>
           </layout>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="timers_box">
         <property name="title">
          <string>Timers</string>
         </property>
         <layout class="QVBoxLayout" name="timers_box_layout">
          <item>
           <widget class="QWidget" name="timers_box_form_w" native="true">
            <layout class="QFormLayout" name="timers_box_form">
             <item row="0" column="0">
              <widget class="QLabel" name="ping_interval_l">
               <property name="toolTip">
                <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Whole seconds of silence before a data channel ping is sent. A server-pushed value overrides it.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
               </property>
               <property name="text">
                <string>Ping Interval</string>
               </property>
               <property name="buddy">
                <cstring>ping_interval</cstring>
               </property>
              </widget>
             </item>
             <item row="0" column="1">
              <widget class="QLineEdit" name="ping_interval"/>
             </item>
             <item row="1" column="0">
              <widget class="QLabel" name="ping_restart_l">
               <property name="toolTip">
                <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Whole seconds without a received packet before reconnecting. 120s is used for UDP with pull enabled.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
               </property>
               <property name="text">
                <string>Ping Restart</string>
               </property>
               <property name="buddy">
                <cstring>ping_restart</cstring>
               </property>
              </widget>
             </item>
             <item row="1" column="1">
              <widget class="QLineEdit" name="ping_restart"/>
             </item>
             <item row="2" column="0" colspan="2">
              <widget class="QCheckBox" name="ping_restart_disabled">
               <property name="toolTip">
                <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Disables the initial 120s UDP pull timeout and any configured ping restart. Conflicts with Ping Restart.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
               </property>
               <property name="text">
                <string>Disable ping restart</string>
               </property>
              </widget>
             </item>
             <item row="3" column="0">
              <widget class="QLabel" name="renegotiate_interval_l">
               <property name="toolTip">
                <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;TLS renegotiation interval.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
               </property>
               <property name="text">
                <string>Renegotiate Interval</string>
               </property>
               <property name="buddy">
                <cstring>renegotiate_interval</cstring>
               </property>
              </widget>
             </item>
             <item row="3" column="1">
              <widget class="QLineEdit" name="renegotiate_interval">
               <property name="placeholderText">
                <string>1h (default)</string>
               </property>
              </widget>
             </item>
             <item row="4" column="0" colspan="2">
              <widget class="QCheckBox" name="renegotiate_disabled">
               <property name="toolTip">
                <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Conflicts with Renegotiate Interval.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
               </property>
               <property name="text">
                <string>Disable time based renegotiation</string>
               </property>
              </widget>
             </item>
             <item row="5" column="0">
              <widget class="QLabel" name="renegotiate_bytes_l">
               <property name="toolTip">
                <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Renegotiate data channel keys after this many bytes. Empty uses the cipher-dependent default.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
               </property>
               <property name="text">
                <string>Renegotiate Bytes</string>
               </property>
               <property name="buddy">
                <cstring>renegotiate_bytes</cstring>
               </property>
              </widget>
             </item>
             <item row="5" column="1">
              <widget class="QLineEdit" name="renegotiate_bytes"/>
             </item>
             <item row="6" column="0">
              <widget class="QLabel" name="renegotiate_packets_l">
               <property name="toolTip">
                <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Renegotiate data channel keys after this many packets. Empty uses the cipher-dependent default.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
               </property>
               <property name="text">
                <string>Renegotiate Packets</string>
               </property>
               <property name="buddy">
                <cstring>renegotiate_packets</cstring>
               </property>
              </widget>
             </item>
             <item row="6" column="1">
              <widget class="QLineEdit" name="renegotiate_packets"/>
             </item>
             <item row="7" column="0">
              <widget class="QLabel" name="tls_timeout_l">
               <property name="toolTip">
                <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Initial retransmission timeout for TLS control packets.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
               </property>
               <property name="text">
                <string>TLS Timeout</string>
               </property>
               <property name="buddy">
                <cstring>tls_timeout</cstring>
               </property>
              </widget>
             </item>
             <item row="7" column="1">
              <widget class="QLineEdit" name="tls_timeout">
               <property name="placeholderText">
                <string>2s (default)</string>
               </property>
              </widget>
             </item>
             <item row="8" column="0">
              <widget class="QLabel" name="handshake_window_l">
               <property name="toolTip">
                <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Maximum time allowed for the initial handshake and each renegotiation.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
               </property>
               <property name="text">
                <string>Handshake Window</string>
               </property>
               <property name="buddy">
                <cstring>handshake_window</cstring>
               </property>
              </widget>
             </item>
             <item row="8" column="1">
              <widget class="QLineEdit" name="handshake_window">
               <property name="placeholderText">
                <string>1m (default)</string>
               </property>
              </widget>
             </item>
             <item row="9" column="0">
              <widget class="QLabel" name="explicit_exit_notify_l">
               <property name="toolTip">
                <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Number of exit notifications sent one second apart when closing a UDP connection.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
               </property>
               <property name="text">
                <string>Explicit Exit Notify</string>
               </property>
               <property name="buddy">
                <cstring>explicit_exit_notify</cstring>
               </property>
              </widget>
             </item>
             <item row="9" column="1">
              <widget class="QLineEdit" name="explicit_exit_notify"/>
             </item>
            </layout>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
      </layout>
     </widget>
    </widget>
   </item>
   <item>
    <widget class="QDialogButtonBox" name="buttonBox">
     <property name="orientation">
      <enum>Qt::Horizontal</enum>
     </property>
     <property name="standardButtons">
      <set>QDialogButtonBox::Cancel|QDialogButtonBox::Ok</set>
     </property>
    </widget>
   </item>
  </layout>
 </widget>
 <customwidgets>
  <customwidget>
   <class>NoWheelComboBox</class>
   <extends>QComboBox</extends>
   <header>include/ui/utils/NoWheelComboBox.h</header>
  </customwidget>
 </customwidgets>
