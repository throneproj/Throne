           </property>
           <property name="text">
            <string>Server Name</string>
           </property>
           <property name="buddy">
            <cstring>tls_server_name</cstring>
           </property>
          </widget>
         </item>
         <item row="1" column="1">
          <widget class="QLineEdit" name="tls_server_name"/>
