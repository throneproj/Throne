             <item row="2" column="0">
              <widget class="QLabel" name="mobile_device_unique_id_l">
               <property name="toolTip">
                <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Mobile device identifier reported to the AnyConnect server.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
               </property>
               <property name="text">
                <string>Device Unique ID</string>
               </property>
               <property name="buddy">
                <cstring>mobile_device_unique_id</cstring>
               </property>
              </widget>
             </item>
             <item row="2" column="1">
              <widget class="QLineEdit" name="mobile_device_unique_id"/>
             </item>
            </layout>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="compliance_box">
         <property name="title">
          <string>Compliance</string>
         </property>
         <layout class="QVBoxLayout" name="compliance_box_layout">
          <item>
           <widget class="QWidget" name="compliance_box_form_w" native="true">
            <layout class="QFormLayout" name="compliance_box_form">
             <item row="0" column="0">
              <widget class="QLabel" name="csd_wrapper_path_l">
               <property name="toolTip">
                <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;External AnyConnect CSD / host scan wrapper executable. Built-in handling is used when empty.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
               </property>
               <property name="text">
                <string>CSD Wrapper Path</string>
               </property>
               <property name="buddy">
                <cstring>csd_wrapper_path</cstring>
