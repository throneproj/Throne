              <widget class="QLineEdit" name="hip_wrapper_path"/>
             </item>
             <item row="2" column="0">
              <widget class="QLabel" name="fortinet_hostcheck_l">
               <property name="toolTip">
                <string>Fortinet hostcheck result, e.g. 0100,10.0.19042. Empty: no hostcheck.</string>
               </property>
               <property name="text">
                <string>Fortinet Hostcheck</string>
               </property>
               <property name="buddy">
                <cstring>fortinet_hostcheck</cstring>
               </property>
              </widget>
             </item>
             <item row="2" column="1">
              <widget class="QLineEdit" name="fortinet_hostcheck"/>
             </item>
             <item row="3" column="0">
              <widget class="QLabel" name="fortinet_check_virtual_desktop_l">
               <property name="toolTip">
                <string>Fortinet virtual desktop check result: MAC addresses joined by |.</string>
               </property>
               <property name="text">
                <string>Fortinet Virtual Desktop</string>
               </property>
               <property name="buddy">
                <cstring>fortinet_check_virtual_desktop</cstring>
