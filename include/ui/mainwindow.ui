       <widget class="QToolButton" name="toolButton_program">
        <property name="minimumSize">
         <size>
          <width>0</width>
          <height>0</height>
         </size>
        </property>
        <property name="styleSheet">
         <string notr="true">QToolButton {
    padding-left: 8px;
    padding-right: 8px;
}

/* The indicator shares the bottom row with the label (ToolButtonTextUnderIcon),
   so the widest button in any language is the tight one -- its text runs closest
   to the arrow. It fits because the drawn chevron only occupies the middle of
   its 16px subcontrol box, leaving ~14px clear at the button edge against the
   label's ~14.5px of slack. Don't pad the buttons to &quot;fix&quot; this: that widens
   all five for a gap only one of them ever needs (#1665). If a future
   translation looks cramped here, check that label first. */
QToolButton::menu-indicator {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    right: 2px;
    bottom: 3px;
}</string>
        </property>
        <property name="text">
         <string>Program</string>
        </property>
        <property name="iconSize">
         <size>
          <width>24</width>
          <height>24</height>
         </size>
        </property>
        <property name="popupMode">
         <enum>QToolButton::ToolButtonPopupMode::InstantPopup</enum>
        </property>
        <property name="toolButtonStyle">
         <enum>Qt::ToolButtonStyle::ToolButtonTextUnderIcon</enum>
        </property>
       </widget>
      </item>
