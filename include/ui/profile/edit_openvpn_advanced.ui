       <item>
        <widget class="QGroupBox" name="session_box">
         <property name="title">
          <string>Session</string>
         </property>
         <layout class="QVBoxLayout" name="session_box_layout">
          <item>
           <widget class="QWidget" name="session_box_form_w" native="true">
            <layout class="QFormLayout" name="session_box_form">
             <item row="0" column="0">
              <widget class="QLabel" name="mode_l">
               <property name="toolTip">
                <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;OpenVPN session mode. tls is used by default; static_key is a deprecated mode without a TLS control channel.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
               </property>
               <property name="text">
                <string>Mode</string>
               </property>
               <property name="buddy">
                <cstring>mode</cstring>
               </property>
              </widget>
             </item>
             <item row="0" column="1">
              <widget class="NoWheelComboBox" name="mode"/>
             </item>
             <item row="1" column="0">
              <widget class="QLabel" name="topology_l">
               <property name="toolTip">
                <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Tunnel topology. The topology pulled from the server is used when empty in TLS mode.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
               </property>
               <property name="text">
                <string>Topology</string>
               </property>
               <property name="buddy">
                <cstring>topology</cstring>
               </property>
              </widget>
             </item>
             <item row="1" column="1">
              <widget class="NoWheelComboBox" name="topology"/>
             </item>
             <item row="2" column="0">
              <widget class="QLabel" name="auth_retry_l">
               <property name="toolTip">
                <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Behavior after username/password authentication fails. none is used by default and treats a permanent failure as terminal.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
               </property>
               <property name="text">
                <string>Auth Retry</string>
               </property>
               <property name="buddy">
                <cstring>auth_retry</cstring>
               </property>
              </widget>
             </item>
             <item row="2" column="1">
              <widget class="NoWheelComboBox" name="auth_retry"/>
             </item>
             <item row="3" column="0" colspan="2">
              <widget class="QCheckBox" name="remote_random">
               <property name="toolTip">
                <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Randomize the server list before connecting.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
               </property>
               <property name="text">
                <string>Randomize server order</string>
               </property>
              </widget>
             </item>
             <item row="4" column="0">
              <widget class="QLabel" name="address_l">
               <property name="toolTip">
                <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Comma separated local tunnel prefixes. At least one is required in static_key mode.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
               </property>
               <property name="text">
                <string>Local Address</string>
               </property>
               <property name="buddy">
                <cstring>address</cstring>
               </property>
              </widget>
             </item>
             <item row="4" column="1">
              <widget class="QLineEdit" name="address">
               <property name="placeholderText">
                <string>10.8.0.2/24, fd00::2/64</string>
               </property>
              </widget>
             </item>
             <item row="5" column="0">
              <widget class="QLabel" name="peer_address_l">
               <property name="toolTip">
                <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;IPv4 tunnel peer address and VPN gateway. Required with an IPv4 local address in static_key mode.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
               </property>
               <property name="text">
                <string>Peer Address</string>
               </property>
               <property name="buddy">
                <cstring>peer_address</cstring>
               </property>
              </widget>
             </item>
             <item row="5" column="1">
              <widget class="QLineEdit" name="peer_address"/>
             </item>
             <item row="6" column="0">
              <widget class="QLabel" name="peer_address_ipv6_l">
               <property name="toolTip">
                <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;IPv6 tunnel peer address and VPN gateway. Required with an IPv6 local address in static_key mode.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
               </property>
               <property name="text">
                <string>Peer Address (IPv6)</string>
               </property>
               <property name="buddy">
                <cstring>peer_address_ipv6</cstring>
               </property>
              </widget>
             </item>
             <item row="6" column="1">
              <widget class="QLineEdit" name="peer_address_ipv6"/>
             </item>
            </layout>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
