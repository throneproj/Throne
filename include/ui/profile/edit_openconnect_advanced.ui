<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>EditOpenConnectAdvanced</class>
 <widget class="QDialog" name="EditOpenConnectAdvanced">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>760</width>
    <height>620</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>OpenConnect Advanced</string>
  </property>
  <layout class="QVBoxLayout" name="dialog_layout">
   <item>
    <widget class="QScrollArea" name="scroll">
     <property name="frameShape">
      <enum>QFrame::NoFrame</enum>
     </property>
     <property name="widgetResizable">
      <bool>true</bool>
     </property>
     <widget class="QWidget" name="scroll_content">
      <layout class="QVBoxLayout" name="content_layout">
       <property name="leftMargin">
        <number>0</number>
       </property>
       <property name="topMargin">
        <number>0</number>
       </property>
       <property name="rightMargin">
        <number>0</number>
       </property>
       <property name="bottomMargin">
        <number>0</number>
       </property>
       <item>
        <widget class="QGroupBox" name="session_box">
         <property name="title">
          <string>Session</string>
         </property>
         <layout class="QVBoxLayout" name="session_box_layout">
          <item>
           <widget class="QWidget" name="session_box_form_w" native="true">
            <layout class="QFormLayout" name="session_box_form">
             <item row="0" column="0">
              <widget class="QLabel" name="cookie_l">
               <property name="toolTip">
                <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Existing authentication session used to connect without first prompting for credentials. The accepted format depends on the flavor.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
               </property>
               <property name="text">
                <string>Cookie</string>
               </property>
               <property name="buddy">
                <cstring>cookie</cstring>
               </property>
              </widget>
             </item>
             <item row="0" column="1">
              <widget class="QLineEdit" name="cookie"/>
             </item>
             <item row="1" column="0">
              <widget class="QLabel" name="reported_os_l">
               <property name="toolTip">
                <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Operating system identity reported to the server. anyconnect, gp and pulse accept linux, linux-64, win, mac-intel, android and apple-ios. The system platform is used by default.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
               </property>
               <property name="text">
                <string>Reported OS</string>
               </property>
               <property name="buddy">
                <cstring>reported_os</cstring>
               </property>
              </widget>
             </item>
             <item row="1" column="1">
              <widget class="QLineEdit" name="reported_os"/>
             </item>
             <item row="2" column="0">
              <widget class="QLabel" name="user_agent_l">
               <property name="toolTip">
                <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;User agent reported to the server. The default is flavor specific.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
               </property>
               <property name="text">
                <string>User Agent</string>
               </property>
               <property name="buddy">
                <cstring>user_agent</cstring>
               </property>
              </widget>
             </item>
             <item row="2" column="1">
              <widget class="QLineEdit" name="user_agent"/>
             </item>
             <item row="3" column="0">
              <widget class="QLabel" name="version_l">
               <property name="toolTip">
                <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Client version reported separately from the user agent. Currently used by AnyConnect XML authentication.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
               </property>
               <property name="text">
                <string>Version</string>
               </property>
               <property name="buddy">
                <cstring>version</cstring>
               </property>
              </widget>
             </item>
             <item row="3" column="1">
              <widget class="QLineEdit" name="version">
               <property name="placeholderText">
                <string>v9.21 (default)</string>
               </property>
              </widget>
             </item>
             <item row="4" column="0">
              <widget class="QLabel" name="local_hostname_l">
               <property name="toolTip">
                <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Local hostname reported to the server. The system hostname is used by default.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
               </property>
               <property name="text">
                <string>Local Hostname</string>
               </property>
               <property name="buddy">
                <cstring>local_hostname</cstring>
               </property>
              </widget>
             </item>
             <item row="4" column="1">
              <widget class="QLineEdit" name="local_hostname"/>
             </item>
            </layout>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="token_box">
         <property name="toolTip">
          <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;This is the token the core generates itself. To use a Throne OTP profile, bind it on the main editor instead.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
         </property>
         <property name="title">
          <string>Software Token</string>
         </property>
         <layout class="QVBoxLayout" name="token_box_layout">
          <item>
           <widget class="QWidget" name="token_box_form_w" native="true">
            <layout class="QFormLayout" name="token_box_form">
             <item row="0" column="0">
              <widget class="QLabel" name="token_mode_l">
               <property name="toolTip">
                <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;totp and hotp are one-time password modes, stoken is an RSA SecurID software token and oidc is an access token used for HTTP Bearer authentication.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
               </property>
               <property name="text">
                <string>Mode</string>
               </property>
               <property name="buddy">
                <cstring>token_mode</cstring>
               </property>
              </widget>
             </item>
             <item row="0" column="1">
              <widget class="NoWheelComboBox" name="token_mode"/>
             </item>
             <item row="1" column="0">
              <widget class="QLabel" name="token_secret_l">
               <property name="toolTip">
                <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;A Base32 secret, a base32: prefixed secret or an otpauth:// URI for totp and hotp; the encoded CTF content for stoken; the access token for oidc. Conflicts with the secret path.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
               </property>
               <property name="text">
                <string>Secret</string>
               </property>
               <property name="buddy">
                <cstring>token_secret</cstring>
               </property>
              </widget>
             </item>
             <item row="1" column="1">
              <widget class="QLineEdit" name="token_secret"/>
             </item>
             <item row="2" column="0">
              <widget class="QLabel" name="token_secret_path_l">
               <property name="toolTip">
                <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Path to the token secret or access token. Conflicts with the inline secret.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
               </property>
               <property name="text">
                <string>Secret Path</string>
               </property>
               <property name="buddy">
                <cstring>token_secret_path</cstring>
               </property>
              </widget>
             </item>
             <item row="2" column="1">
              <widget class="QLineEdit" name="token_secret_path"/>
             </item>
             <item row="3" column="0">
              <widget class="QLabel" name="token_pin_l">
               <property name="toolTip">
                <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;RSA SecurID PIN for stoken mode.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
               </property>
               <property name="text">
                <string>PIN</string>
               </property>
               <property name="buddy">
                <cstring>token_pin</cstring>
               </property>
              </widget>
             </item>
             <item row="3" column="1">
              <widget class="QLineEdit" name="token_pin"/>
             </item>
             <item row="4" column="0">
              <widget class="QLabel" name="token_password_l">
               <property name="toolTip">
                <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Password for decrypting a password-protected RSA SecurID token.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
               </property>
               <property name="text">
                <string>Password</string>
               </property>
               <property name="buddy">
                <cstring>token_password</cstring>
               </property>
              </widget>
             </item>
             <item row="4" column="1">
              <widget class="QLineEdit" name="token_password"/>
             </item>
             <item row="5" column="0">
              <widget class="QLabel" name="token_device_id_l">
               <property name="toolTip">
                <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Device ID for decrypting a device-bound RSA SecurID token.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
               </property>
               <property name="text">
                <string>Device ID</string>
               </property>
               <property name="buddy">
                <cstring>token_device_id</cstring>
               </property>
              </widget>
             </item>
             <item row="5" column="1">
              <widget class="QLineEdit" name="token_device_id"/>
             </item>
             <item row="6" column="0">
              <widget class="QLabel" name="token_counter_l">
               <property name="toolTip">
                <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Initial counter for hotp mode. Empty uses the counter from an otpauth:// URI, otherwise zero.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
               </property>
               <property name="text">
                <string>Counter</string>
               </property>
               <property name="buddy">
                <cstring>token_counter</cstring>
               </property>
              </widget>
             </item>
             <item row="6" column="1">
              <widget class="QLineEdit" name="token_counter"/>
             </item>
            </layout>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="tls_box">
         <property name="title">
          <string>TLS</string>
         </property>
         <layout class="QVBoxLayout" name="tls_box_layout">
          <item>
           <widget class="QWidget" name="tls_box_form_w" native="true">
            <layout class="QFormLayout" name="tls_box_form">
             <item row="0" column="0">
              <widget class="QLabel" name="tls_peer_fingerprint_l">
               <property name="toolTip">
                <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Allowed server certificate fingerprints, one per line. Accepts a bare SHA-1 fingerprint or sha1:, sha256: and pin-sha256: values, abbreviated to at least four characters.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
               </property>
               <property name="text">
                <string>Peer Fingerprint</string>
               </property>
               <property name="buddy">
                <cstring>tls_peer_fingerprint</cstring>
               </property>
              </widget>
             </item>
             <item row="0" column="1">
              <widget class="QPushButton" name="tls_peer_fingerprint">
               <property name="text">
                <string>Not set</string>
               </property>
              </widget>
             </item>
             <item row="1" column="0" colspan="2">
              <widget class="QCheckBox" name="tls_system_trust_disabled">
               <property name="toolTip">
                <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Use a CA certificate or a peer fingerprint to establish trust when this is enabled.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
               </property>
               <property name="text">
                <string>Disable the system CA certificate pool</string>
               </property>
              </widget>
             </item>
             <item row="2" column="0">
              <widget class="QLabel" name="tls_certificate_authority_path_l">
               <property name="toolTip">
                <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Conflicts with the inline CA certificate on the main editor.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
               </property>
               <property name="text">
                <string>CA Certificate Path</string>
               </property>
               <property name="buddy">
                <cstring>tls_certificate_authority_path</cstring>
               </property>
              </widget>
             </item>
             <item row="2" column="1">
              <widget class="QLineEdit" name="tls_certificate_authority_path"/>
             </item>
             <item row="3" column="0">
              <widget class="QLabel" name="tls_client_certificate_path_l">
               <property name="toolTip">
                <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Conflicts with the inline client certificate on the main editor.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
               </property>
               <property name="text">
                <string>Client Certificate Path</string>
               </property>
               <property name="buddy">
                <cstring>tls_client_certificate_path</cstring>
               </property>
              </widget>
             </item>
             <item row="3" column="1">
              <widget class="QLineEdit" name="tls_client_certificate_path"/>
             </item>
             <item row="4" column="0">
              <widget class="QLabel" name="tls_client_key_path_l">
               <property name="toolTip">
                <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Conflicts with the inline client key on the main editor.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
               </property>
               <property name="text">
                <string>Client Key Path</string>
               </property>
               <property name="buddy">
                <cstring>tls_client_key_path</cstring>
               </property>
              </widget>
             </item>
             <item row="4" column="1">
              <widget class="QLineEdit" name="tls_client_key_path"/>
             </item>
             <item row="5" column="0">
              <widget class="QLabel" name="tls_mca_certificate_l">
               <property name="toolTip">
                <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;AnyConnect multiple-certificate authentication chain in PEM format. Conflicts with the MCA certificate path.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
               </property>
               <property name="text">
                <string>MCA Certificate</string>
               </property>
               <property name="buddy">
                <cstring>tls_mca_certificate</cstring>
               </property>
              </widget>
             </item>
             <item row="5" column="1">
              <widget class="QPushButton" name="tls_mca_certificate">
               <property name="text">
                <string>Not set</string>
               </property>
              </widget>
             </item>
             <item row="6" column="0">
              <widget class="QLabel" name="tls_mca_certificate_path_l">
               <property name="toolTip">
                <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Conflicts with the inline MCA certificate.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
               </property>
               <property name="text">
                <string>MCA Certificate Path</string>
               </property>
               <property name="buddy">
                <cstring>tls_mca_certificate_path</cstring>
               </property>
              </widget>
             </item>
             <item row="6" column="1">
              <widget class="QLineEdit" name="tls_mca_certificate_path"/>
             </item>
             <item row="7" column="0">
              <widget class="QLabel" name="tls_mca_key_l">
               <property name="toolTip">
                <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;AnyConnect multiple-certificate authentication private key in PEM format. Conflicts with the MCA key path.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
               </property>
               <property name="text">
                <string>MCA Key</string>
               </property>
               <property name="buddy">
                <cstring>tls_mca_key</cstring>
               </property>
              </widget>
             </item>
             <item row="7" column="1">
              <widget class="QPushButton" name="tls_mca_key">
               <property name="text">
                <string>Not set</string>
               </property>
              </widget>
             </item>
             <item row="8" column="0">
              <widget class="QLabel" name="tls_mca_key_path_l">
               <property name="toolTip">
                <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Conflicts with the inline MCA key.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
               </property>
               <property name="text">
                <string>MCA Key Path</string>
               </property>
               <property name="buddy">
                <cstring>tls_mca_key_path</cstring>
               </property>
              </widget>
             </item>
             <item row="8" column="1">
              <widget class="QLineEdit" name="tls_mca_key_path"/>
             </item>
             <item row="9" column="0">
              <widget class="QLabel" name="tls_mca_key_password_l">
               <property name="toolTip">
                <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Password for the encrypted MCA private key.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
               </property>
               <property name="text">
                <string>MCA Key Password</string>
               </property>
               <property name="buddy">
                <cstring>tls_mca_key_password</cstring>
